# Copy to .env and fill in. Never commit .env.

# Database (docker-compose sets this for you; local dev defaults to SQLite ./kubaho.db)
POSTGRES_PASSWORD=change-me
# DATABASE_URL=postgresql+psycopg://kubaho:change-me@localhost:5432/kubaho

# MQTT broker (Eclipse Mosquitto)
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TLS=false

# Africa's Talking SMS
AT_USERNAME=sandbox
AT_API_KEY=
AT_SENDER_ID=

# Alerting rules
ESCALATION_MINUTES=5
BATHROOM_DWELL_MINUTES=30
RESTLESS_ENERGY_THRESHOLD=0.3

# Dashboard -> API
VITE_API_URL=http://localhost:8000
CORS_ORIGINS=*
